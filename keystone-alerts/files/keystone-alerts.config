config main 'main'
	option check_secs '30'

config alert 'internet'
	option mode 'buzz'

config alert 'signal'
	option mode 'log'
	option rsrp_below '-110'

config alert 'device'
	option mode 'buzz'

config alert 'data'
	option mode 'buzz'
	option warn_pct '80'
	option fairuse_pct '90'

config alert 'restart'
	option mode 'log'
