#!/bin/sh

mode=$1
T=${KS_TMP:-/tmp/keystone-history}
E=${KS_ETC:-/etc/keystone-history}
SYS=${KS_SYS:-/sys/class/net}
G5=${KS_5G:-/tmp/5gmodem}
UBUS=${UBUS:-ubus}
MMCLI=${MMCLI:-mmcli}
VNSTAT=${VNSTAT:-vnstat}
FW_STATS=${KS_FW_STATS:-/etc/5gmodem/stats}
PING=${PING:-ping}
CURL=${CURL:-curl}
UCI=${UCI:-uci}
DATE=${DATE:-date}
MINTIME=${KS_MIN_TIME:-1704067200}
. "${KS_COMMON:-/usr/share/keystone-history/common.sh}" || exit 1

now=$($DATE +%s)
[ "$now" -ge "$MINTIME" ] 2>/dev/null || exit 0
mkdir -p "$T"
month=$($DATE +%Y-%m)

kd=$($UCI -q get keystone-history.main.keep_days)
case $kd in ''|0*|???*|*[!0-9]*) kd=7 ;; esac
[ "$kd" -le 30 ] || kd=7
cap=$((150000 * kd))
[ "$cap" -ge 1000000 ] || cap=1000000
[ "$cap" -le 4000000 ] || cap=4000000

prune() {
	[ -f "$1" ] || return 0
	awk -v c=$((now - kd * 86400)) '$1 >= c' "$1" > "$1.new" && mv "$1.new" "$1"
	if [ "$(wc -c < "$1")" -gt "$cap" ]; then
		tail -c "$cap" "$1" | sed 1d > "$1.new" && mv "$1.new" "$1"
	fi
}

if [ "$mode" = prune ]; then
	prune "$T/points"
	prune "$E/points"
	exit 0
fi

num() { sed -n "s/.*\"$1\" *: *\"\{0,1\}\(-\{0,1\}[0-9][0-9.]*\).*/\1/p" | head -n 1; }
str() { sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p" | head -n 1; }

kv() {
	awk -v want="$1" '
		/"key":/ { split($0, a, "\""); k = tolower(a[4]) }
		/"value":/ { split($0, a, "\""); if (k == want || k ~ (" " want "$")) { print a[4]; exit } }
	'
}

join_bands() {
	sed 's/["\]//g; s/[^ -~]//g; s/^ *//; s/ .*//' | awk '$0 != "" && $0 != "-" { printf "%s%s", s, $0; s = "+" }'
}

firmware_month() {
	f="$FW_STATS/traffic.sim-$1.$month"
	if [ -r "$f" ]; then
		awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { print $1, $2; exit }' "$f"
		return
	fi
	[ "$(ls "$T"/daily.* 2>/dev/null | wc -l)" -le 1 ] || return 0
	$VNSTAT --oneline b -i "$dev" 2>/dev/null |
		awk -F';' -v m="$month" '$8 == m && $9 ~ /^[0-9]+$/ && $10 ~ /^[0-9]+$/ { print $9, $10 }'
}

fill_month() {
	awk -v m="$month" -v fd="$2" -v fu="$3" '
		{ r[NR] = $0; day[NR] = $1
		  if (substr($1, 1, 7) == m) { sd += $2; su += $3; if (first == "" || $1 < first) first = $1 } }
		END {
			gd = fd - sd; gu = fu - su; if (gd < 0) gd = 0; if (gu < 0) gu = 0
			n = substr(first, 9, 2) - 1
			fill = first != "" && gd + gu >= 1048576
			for (i = 1; i <= NR; i++) {
				if (fill && n < 1 && day[i] == first) { split(r[i], f, " "); printf "%s %.0f %.0f\n", f[1], f[2] + gd, f[3] + gu }
				else print r[i]
			}
			if (fill && n >= 1) for (d = 1; d <= n; d++) {
				ed = int(gd / n); eu = int(gu / n)
				if (d == 1) { ed += gd - ed * n; eu += gu - eu * n }
				printf "%s-%02d %.0f %.0f\n", m, d, ed, eu
			}
		}' "$1" | sort
}

dev=$(ks_wan_dev)
[ -n "$dev" ] || dev=wwan0

rsrp=- sinr=- pci=- earfcn=- band=- bands=-
f=$(find "$G5" -name 'metrics_*.json' -mmin -5 2>/dev/null | head -n 1)
if [ -n "$f" ]; then
	rsrp=$(num rsrp < "$f"); sinr=$(num sinr < "$f"); pci=$(num pci < "$f"); earfcn=$(num earfcn < "$f")
	band=$(str pband < "$f")
	bands=$(for k in pband s1band s2band s3band s4band; do str $k < "$f"; done | join_bands)
elif $UBUS list qmodem >/dev/null 2>&1; then
	sec=$($UCI -q show qmodem | sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p' | head -n 1)
	arg="{\"config_section\":\"$sec\"}"
	cell=$($UBUS call qmodem cell_info "$arg" 2>/dev/null)
	rsrp=$(printf '%s\n' "$cell" | kv rsrp | sed -n 's/^\(-\{0,1\}[0-9][0-9.]*\).*/\1/p')
	sinr=$(printf '%s\n' "$cell" | kv sinr | sed -n 's/^\(-\{0,1\}[0-9][0-9.]*\).*/\1/p')
	cb=$($UBUS call qmodem get_current_band "$arg" 2>/dev/null)
	pci=$(printf '%s\n' "$cb" | num pci)
	earfcn=$(printf '%s\n' "$cb" | num channel)
	band=$(printf '%s\n' "$cb" | str band_name)
	bands=$(printf '%s\n' "$cb" | sed -n 's/.*"band_name" *: *"\([^"]*\)".*/\1/p' | join_bands)
elif mm=$($MMCLI -m any --signal-get -K 2>/dev/null) && [ -n "$mm" ]; then
	mmv() { printf '%s\n' "$mm" | sed -n "s/^modem\.signal\.$1 *: *\(-\{0,1\}[0-9][0-9.]*\).*/\1/p" | head -n 1; }
	rsrp=$(mmv 5g.rsrp); [ -n "$rsrp" ] || rsrp=$(mmv lte.rsrp)
	sinr=$(mmv 5g.snr); [ -n "$sinr" ] || sinr=$(mmv lte.snr)
	[ "$(printf '%s\n' "$mm" | sed -n 's/^modem\.signal\.refresh\.rate *: *\([0-9]*\).*/\1/p')" = 0 ] && $MMCLI -m any --signal-setup=60 >/dev/null 2>&1
fi
for v in rsrp sinr pci earfcn band bands; do
	eval "x=\$$v"
	[ -n "$x" ] || eval "$v=-"
done
band=$(printf '%s' "$band" | sed 's/["\]//g; s/[^ -~]//g' | tr ' ' '_')
[ -n "$band" ] || band=-

target=$($UCI -q get keystone-history.main.ping_target)
[ -n "$target" ] || target=8.8.8.8
tcp=$($UCI -q get keystone-history.main.tcp_target)
case $tcp in ""|*[!A-Za-z0-9.-]*) tcp=1.1.1.1 ;; esac
ms=$($PING -c 1 -W 2 -I "$dev" "$target" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -n 1)
method=icmp
if [ -z "$ms" ]; then
	method=none
	if command -v "$CURL" >/dev/null 2>&1; then
		ms=$($CURL --interface "$dev" -o /dev/null -s -m 3 -w '%{time_connect}' "http://$tcp/" 2>/dev/null | awk '{ m = int($1 * 1000 + 0.5); if (m > 0) print m }')
		[ -z "$ms" ] || method=tcp
	fi
fi
[ -n "$ms" ] || ms=-
echo "$method" > "$T/method"

[ "$(tail -n 1 "$T/points" 2>/dev/null | cut -d" " -f1)" = "$now" ] || echo "$now $rsrp $sinr $ms $pci $earfcn $band $bands" >> "$T/points"
prune "$T/points"

rx=$(cat "$SYS/$dev/statistics/rx_bytes" 2>/dev/null)
tx=$(cat "$SYS/$dev/statistics/tx_bytes" 2>/dev/null)
if [ -n "$rx" ] && [ -n "$tx" ]; then
	xd=0 xu=0
	if [ -f "$T/last" ]; then
		read -r ldev lrx ltx < "$T/last"
		if [ "$ldev" = "$dev" ]; then
			if [ "$rx" -ge "$lrx" ]; then xd=$((rx - lrx)); else xd=$rx; fi
			if [ "$tx" -ge "$ltx" ]; then xu=$((tx - ltx)); else xu=$tx; fi
		fi
	fi
	dd=0 du=0
	[ -f "$T/traffic.$month" ] && read -r dd du < "$T/traffic.$month"
	daily="$T/daily.$(ks_sim_key)"
	if ! ls "$T"/daily.* >/dev/null 2>&1 && [ "$((${dd:-0} + ${du:-0}))" -gt 0 ]; then
		echo "$month-01 ${dd:-0} ${du:-0}" > "$daily"
	fi
	[ -f "$daily" ] || : > "$daily"
	fw=$(firmware_month "$(ks_sim_key)")
	awk -v d="$($DATE +%F)" -v xd=$xd -v xu=$xu '
		$1 == d { $2 += xd; $3 += xu; seen = 1 }
		{ print $1, $2, $3 }
		END { if (!seen) print d, xd, xu }
	' "$daily" 2>/dev/null > "$daily.new"
	if [ -n "$fw" ]; then
		fill_month "$daily.new" $fw > "$daily.fill" && mv "$daily.fill" "$daily.new"
	fi
	tail -n 100 "$daily.new" > "$daily" && rm -f "$daily.new"
	echo "$((${dd:-0} + xd)) $((${du:-0} + xu))" > "$T/traffic.$month"
	if [ -n "$fw" ]; then
		echo "$fw" | awk -v t="$T/traffic.$month" '{ getline c < t; close(t); split(c, o, " ")
			printf "%.0f %.0f\n", ($1 > o[1] ? $1 : o[1]), ($2 > o[2] ? $2 : o[2]) > t }'
	fi
	echo "$dev $rx $tx" > "$T/last"
fi

last=0
[ -f "$T/flushed" ] && read -r last < "$T/flushed"
since=$((now - last))
if [ "$mode" = flush ] || [ "$since" -lt 0 ] || [ "$since" -ge 3600 ]; then
	mkdir -p "$E"
	cp "$T/points" "$E/points.new"
	mv "$E/points.new" "$E/points"
	for t in "$T"/traffic.* "$T"/daily.*; do
		[ -f "$t" ] && cp "$t" "$E/"
	done
	echo "$now" > "$T/flushed"
fi
