#!/bin/sh
# Keystone devices: data used per device, per billing period.

T=${KS_TMP:-/tmp/keystone-devices}
E=${KS_ETC:-/etc/keystone-devices}
UCI=${UCI:-uci}
DATE=${DATE:-date}
NFT=${NFT:-nft}
IPT=${IPT:-iptables}
NLBW=${NLBW:-nlbw}
PIDOF=${PIDOF:-pidof}
IP=${IP:-ip}
LEASES=${KS_LEASES:-/tmp/dhcp.leases}
MAX_DEVICES=512
KEEP_PERIODS=3
. "${KS_COMMON:-/usr/share/keystone-devices/common.sh}" || exit 1

R="$T/run"
mkdir -p "$R"

backend() {
	if [ -n "$($PIDOF nlbwmon 2>/dev/null)" ]; then
		echo nlbwmon
	elif [ -n "${KS_FW4-$(command -v fw4)}" ]; then
		echo nft
	else
		echo iptables
	fi
}

# The LAN side is any bridge, so a changing WAN device never matters.
nft_table() {
	$NFT list table inet keystone_devices >/dev/null 2>&1 && return 0
	$NFT -f - <<-'N' >/dev/null 2>&1
	table inet keystone_devices {
		set down4 { type ipv4_addr; size 4096; flags dynamic,timeout; timeout 7d; counter; }
		set up4 { type ipv4_addr; size 4096; flags dynamic,timeout; timeout 7d; counter; }
		set down6 { type ipv6_addr; size 4096; flags dynamic,timeout; timeout 7d; counter; }
		set up6 { type ipv6_addr; size 4096; flags dynamic,timeout; timeout 7d; counter; }
		chain fwd {
			type filter hook forward priority -150; policy accept;
			oifname "br-*" update @down4 { ip daddr }
			iifname "br-*" update @up4 { ip saddr }
			oifname "br-*" update @down6 { ip6 daddr }
			iifname "br-*" update @up6 { ip6 saddr }
		}
	}
	N
}

# nft_set <name>: "ip bytes" per element
nft_set() {
	$NFT list set inet keystone_devices "$1" 2>/dev/null | tr '\n' ' ' |
		sed -n 's/.*elements = {\([^}]*\)}.*/\1/p' | tr ',' '\n' |
		awk '{ for (i = 1; i < NF; i++) if ($i == "bytes") { print $1, $(i + 1); break } }'
}

# Address to MAC, from DHCP leases and the neighbour table on the LAN bridges.
addresses() {
	{
		awk 'NF >= 4 { print $3, tolower($2) }' "$LEASES" 2>/dev/null
		$IP neigh show 2>/dev/null | awk '$2 == "dev" && $3 ~ /^br-/ && $4 == "lladdr" && $NF != "FAILED" && $NF != "INCOMPLETE" { print $1, tolower($5) }'
	} | awk 'length($2) == 17 && !s[$1]++'
}

ipt_rules() {
	local ip
	$IPT -w -C FORWARD -j KS_DEVICES >/dev/null 2>&1 || {
		$IPT -w -N KS_DEVICES >/dev/null 2>&1
		$IPT -w -I FORWARD 1 -j KS_DEVICES >/dev/null 2>&1
	}
	for ip in $(awk '$1 ~ /^[0-9.]+$/ { print $1 }' "$R/addr" | head -n "$MAX_DEVICES"); do
		$IPT -w -C KS_DEVICES -d "$ip" -j RETURN >/dev/null 2>&1 || $IPT -w -A KS_DEVICES -d "$ip" -j RETURN >/dev/null 2>&1
		$IPT -w -C KS_DEVICES -s "$ip" -j RETURN >/dev/null 2>&1 || $IPT -w -A KS_DEVICES -s "$ip" -j RETURN >/dev/null 2>&1
	done
}

# raw counters now, as "key down up": an address (nft, iptables) or a MAC (nlbwmon)
read_counters() {
	case $1 in
	nlbwmon)
		$NLBW -c json -g mac 2>/dev/null | tr -d '\n' | awk '
			{
				c = $0; sub(/.*"columns":\[/, "", c); sub(/\].*/, "", c); gsub(/"/, "", c)
				n = split(c, col, ",")
				for (i = 1; i <= n; i++) { if (col[i] == "mac") m = i; if (col[i] == "rx_bytes") d = i; if (col[i] == "tx_bytes") u = i }
				rows = $0; sub(/.*"data":\[\[/, "", rows); sub(/\]\].*/, "", rows)
				k = split(rows, row, /\],\[/)
				for (j = 1; j <= k; j++) {
					split(row[j], f, ","); gsub(/"/, "", f[m])
					# nlbwmon files traffic it cannot tie to a device under an all-zero MAC.
					if (f[m] != "00:00:00:00:00:00") print tolower(f[m]), f[d] + 0, f[u] + 0
				}
			}' ;;
	nft)
		{ nft_set down4 | sed 's/$/ d/'; nft_set down6 | sed 's/$/ d/'; nft_set up4 | sed 's/$/ u/'; nft_set up6 | sed 's/$/ u/'; } | by_key ;;
	iptables)
		$IPT -w -nvxL KS_DEVICES 2>/dev/null | awk '
			$3 == "RETURN" && $9 != "0.0.0.0/0" { print $9, $2, "d" }
			$3 == "RETURN" && $8 != "0.0.0.0/0" { print $8, $2, "u" }' | by_key ;;
	esac
}

# "key bytes d|u" lines to "key down up"
by_key() {
	awk '{ if ($3 == "d") d[$1] += $2; else u[$1] += $2; s[$1] = 1 }
		END { for (k in s) printf "%s %.0f %.0f\n", k, d[k], u[k] }'
}

period_start() {
	local bd
	bd=$($UCI -q get keystone-history.sim_$(ks_sim_key).billing_day)
	ks_period_start "$($DATE +%F)" "${bd:-1}"
}

sample() {
	local b ps f
	b=$(backend)
	addresses > "$R/addr"
	awk '{ print $2 }' "$R/addr" | awk '!s[$1]++' | head -n "$MAX_DEVICES" > "$T/macs"
	case $b in
	nft) nft_table || b=none ;;
	iptables) ipt_rules ;;
	esac
	echo "$b" > "$T/backend"
	[ "$b" = none ] && return 0
	read_counters "$b" > "$R/now"
	ps=$(period_start)
	f="$T/period.$ps"
	[ -f "$f" ] || : > "$f"
	# Counters are kept per address, so a device that leaves, comes back or changes
	# address is never counted twice: only what each address added since last time is
	# credited, to whichever device holds it now. A counter that went down was reset or
	# expired and is new traffic. The first look at counters that were already running
	# (daemon restart) only takes a baseline; nlbwmon instead brings its month so far.
	first=0
	[ -e "$R/raw" ] || { [ "$b" = nlbwmon ] || first=1; : > "$R/raw"; }
	awk -v first=$first 'FILENAME == ARGV[1] { ld[$1] = $2; lu[$1] = $3; next }
		{
			had = $1 in ld
			dd = had && $2 >= ld[$1] ? $2 - ld[$1] : $2
			du = had && $3 >= lu[$1] ? $3 - lu[$1] : $3
			if (!first && dd + du > 0) printf "%s %.0f %.0f\n", $1, dd, du
		}' "$R/raw" "$R/now" > "$R/delta"
	awk 'FILENAME == ARGV[1] { v[$1] = $0; next } { v[$1] = $0 } END { for (k in v) print v[k] }' "$R/raw" "$R/now" | tail -n 8192 > "$R/raw.new"
	mv "$R/raw.new" "$R/raw"
	if [ "$b" = nlbwmon ]; then cp "$R/delta" "$R/credit"; else
		awk 'FILENAME == ARGV[1] { mac[$1] = $2; next } ($1 in mac) { print mac[$1], $2, $3 }' "$R/addr" "$R/delta" > "$R/credit"
	fi
	awk 'FILENAME == ARGV[1] { d[$1] = $2; u[$1] = $3; s[$1] = 1; next }
		{ d[$1] += $2; u[$1] += $3; s[$1] = 1 }
		END { for (m in s) if (d[m] + u[m] > 0) printf "%s %.0f %.0f\n", m, d[m], u[m] }' "$f" "$R/credit" > "$f.new"
	mv "$f.new" "$f"
	ls "$T"/period.* 2>/dev/null | sort -r | tail -n +$((KEEP_PERIODS + 1)) | while read -r old; do
		rm -f "$old" "$E/${old##*/}"
	done
}

restore() {
	[ -e "$T/macs" ] && return 0
	cp "$E"/period.* "$T/" 2>/dev/null
	return 0
}

[ -n "$KS_DEVICES_LIB" ] && return 0

case "$1" in
sample) sample ;;
flush) ks_flush "$T" "$E" "$T/flushed" 1 ;;
stop)
	# Count the last minute, keep it, then take the rules out again.
	sample; ks_flush "$T" "$E" "$T/flushed" 1
	$NFT delete table inet keystone_devices >/dev/null 2>&1
	$IPT -w -D FORWARD -j KS_DEVICES >/dev/null 2>&1
	$IPT -w -F KS_DEVICES >/dev/null 2>&1
	$IPT -w -X KS_DEVICES >/dev/null 2>&1
	rm -f "$R/raw" ;;
run)
	restore
	while :; do
		sample
		ks_flush "$T" "$E" "$T/flushed" 0
		sleep 60
	done ;;
esac
