#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /tmp/keystone
	[ -e /tmp/keystone/points ] || { cp /etc/keystone/* /tmp/keystone/ 2>/dev/null && date +%s > /tmp/keystone/flushed; }
	procd_open_instance
	procd_set_param command /bin/sh -c 'while :; do /usr/sbin/keystone-collect; sleep 120; done'
	procd_set_param file /etc/config/keystone
	procd_set_param respawn 3600 10 0
	procd_close_instance
}

stop_service() {
	/usr/sbin/keystone-collect flush
}

service_triggers() {
	procd_add_reload_trigger keystone
}
